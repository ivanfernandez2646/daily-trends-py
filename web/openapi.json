              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/feed/list": {
      "get": {
        "tags": [
          "feeds"
        ],
        "summary": "List Feeds",
        "description": "A page of the feeds, or only those of `category`, of `source` and with any word of `q`,\nnewest first.\n\nFeeds that share their creation date are ordered by id. Feeds saved while a client browses\nnever shift its next pages: they appear on a new first page.",
        "operationId": "list_feeds_feed_list_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/FeedCategory"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Category"
            }
          },
          {
            "name": "source",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/FeedSource"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Source"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ],
              "description": "Words to look for in the title and the description, in Spanish: a feed matches when it has any of them, ignoring case and accents, and matching their stems but not fragments.",
              "title": "Q"
            },
            "description": "Words to look for in the title and the description, in Spanish: a feed matches when it has any of them, ignoring case and accents, and matching their stems but not fragments."
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The `next_cursor` of a previous page; absent for the first.",
              "title": "Cursor"
            },
            "description": "The `next_cursor` of a previous page; absent for the first."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeedPageResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request: the body, the id or a value",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error, such as an invalid stored feed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/feed/home": {
      "get": {
        "tags": [
          "feeds"
        ],
        "summary": "Home Feeds",
        "description": "The 2 newest feeds of each external source, filled with the newest of any of them up to 10,\nnewest first.",
        "operationId": "home_feeds_feed_home_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/FeedResponse"
                  },
                  "type": "array",
                  "title": "Response Home Feeds Feed Home Get"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected error, such as an invalid stored feed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccessTokenResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "const": "bearer",
            "title": "Token Type"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "token_type",
          "expires_in"
        ],
        "title": "AccessTokenResponse"
      },
      "AdminSessionResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "token_expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Token Expires At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "email",
          "created_at",
          "token_expires_at"
        ],
        "title": "AdminSessionResponse"
      },
      "CreateFeedRequest": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "author": {
            "type": "string",
            "title": "Author"
          },
          "category": {
            "$ref": "#/components/schemas/FeedCategory"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          }
        },
        "type": "object",
        "required": [
          "title",
          "author",
          "category"
        ],
        "title": "CreateFeedRequest"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "type": "string",
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "FeedCategory": {
        "type": "string",
        "enum": [
          "POLITICS",
          "INTERNATIONAL",
          "ECONOMY",
          "SOCIETY",
          "SPORTS",
          "CULTURE",
          "TECHNOLOGY",
          "SCIENCE",
          "HEALTH",
          "OPINION",
          "OTHER"
        ],
        "title": "FeedCategory"
      },
      "FeedPageResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/FeedResponse"
            },
            "type": "array",
            "title": "Items"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor",
            "description": "Pass it as `cursor` to get the next page; `null` on the last page."
          }
        },
        "type": "object",
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "FeedPageResponse"
      },
      "FeedResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "author": {
            "type": "string",
            "title": "Author"
          },
          "source": {
            "$ref": "#/components/schemas/FeedSource"
          },
          "category": {
            "$ref": "#/components/schemas/FeedCategory"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "author",
          "source",
          "category",
          "url",
          "created_at",
          "updated_at"
        ],
        "title": "FeedResponse"
      },
      "FeedSource": {
        "type": "string",
        "enum": [
          "CMS",
          "EL_PAIS",
          "EL_MUNDO",
          "EL_ESPANOL",
          "EL_CONFIDENCIAL",
          "LA_RAZON",
          "LA_VANGUARDIA"
        ],
        "title": "FeedSource"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "UpdateFeedRequest": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "category": {
            "$ref": "#/components/schemas/FeedCategory"
          }
        },
        "type": "object",
        "title": "UpdateFeedRequest",
        "description": "Only the fields that were sent: an absent key keeps the value, `null` is a value."
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
