# Copy to `.env` (git-ignored). Environment variables win over this file.

# production, dev or test. It selects the default MONGO_URL.
# ENV=dev

# Defaults: dev → mongodb://localhost:27017/daily-trends-dev,
# test → mongodb://localhost:27017/daily-trends-test. Required in production.
# MONGO_URL=mongodb://localhost:27017/daily-trends-dev

# PORT=5000

# IANA zone of the business day: "today" for the front page and "the same day" for scraping.
# TIMEZONE=Europe/Madrid

# Seconds before a request to a scraped site gives up.
# SCRAPE_TIMEOUT_SECONDS=10

# Scrape every source at startup and then on a schedule. false leaves only /feed/scrap.
# SCRAPE_SCHEDULE_ENABLED=true

# Seconds from the end of a scheduled run to the start of the next one.
# SCRAPE_INTERVAL_SECONDS=7200
